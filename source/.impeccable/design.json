      "css": ".card{display:flex;align-items:center;justify-content:center;flex-direction:column;box-sizing:border-box;padding:20px;height:275px;width:100%;max-width:337px;border:none;border-radius:25px;color:#27232c;box-shadow:0 5px 12px rgba(36,29,45,.12);background-color:#dcd1e9;background-image:radial-gradient(circle,rgba(62,46,67,.16) .85px,transparent 1px);background-size:15px 15px}.art{display:grid;place-items:center;width:62%;height:65%;transform:rotate(-5deg);filter:drop-shadow(0 4px 3px rgba(48,34,44,.13))}.label{display:block;padding:8px;border-radius:8px;background:#fff;color:#29262c;box-shadow:0 2px 4px rgba(32,28,40,.16);font:900 23px/1.16 ui-rounded,\"Trebuchet MS\",sans-serif;transform:rotate(-3deg);letter-spacing:-.032em}.card strong{font:900 31px/1.15 ui-rounded,\"Trebuchet MS\",sans-serif;letter-spacing:-.035em}.card small{font-size:12px;margin-top:9px;color:#50464f}.card:focus-visible{outline:3px solid #50417e;outline-offset:3px}"
