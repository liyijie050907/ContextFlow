  "narrative": {
    "northStar": "翻过词卡，在句子里认出这个词",
    "overview": "阅读正文、目标词、划词翻译和收藏共用淡紫纸面与圆体词头。",
    "keyCharacteristics": [
      "浅紫色标出主要操作和当前导航。",
      "只有学习材料使用点阵纸、模切物件或文字贴纸。",
      "英语阅读用衬线字体，词卡标题用较粗的圆体字。"
    ],
    "rules": [],
    "dos": [
      "为缺少物件图片的个人词条使用可换行文字贴纸。",
      "让键盘与触屏用户都能翻面、前后切换及关闭词卡。",
      "只有成功保存义项后才显示“已收进生词本”。"
    ],
    "donts": [
      "长文保持素色，动效仅在交互时触发。"
    ]
  }
